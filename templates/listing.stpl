<!DOCTYPE html>

<html>
  <head>
    <% include!("./header.stpl"); %>
  </head>
  <body>
    <div class="top-bar">
      <a class="home" href="/">Home</a>
      <% for breadcrumb in breadcrumbs { %>
        <p class="breadcrumb">/</p>
        <a class="breadcrumb" href="<%= breadcrumb.href %>"><%= breadcrumb.name %></a>
      <% } %>
    </div>
    <% if !info.is_empty() { %>
      <div class="dir-info-container">
        <div class="dir-info">
          <%- info %>
        </div>
      </div>
    <% } %>
    <div class="listing-container">
      <% for directory in directories { %>
        <div class="listing-thumbnail">
          <a href="/<%= directory.public_path %>">
            <img src="<%= directory.thumbnail_path %>" alt="<%= directory.name %>" loading="lazy" />
            <p class="caption"><%= directory.name %></p> 
          </a>
        </div>
      <% } %>
      <% for file in files { %>
        <div class="listing-thumbnail">
          <a href="/<%= file.public_path %>">
            <img src="/<%= file.thumbnail_path %>" alt="<%= file.name %>" loading="lazy" />
          </a>
        </div>
      <% } %>
    </div> <!-- listing-container -->
  </body>
</html>
