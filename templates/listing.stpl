<!DOCTYPE html>

<html>
  <head>
    <% include!("./header.stpl"); %>
  </head>
  <body>
    <div class="top-bar">
      <a href="/">
        <img class="logo" src="/static/logo.svg" alt="gallery logo" />
      </a>
      <a class="home" href="/">Linkin kuvagalleria</a>
      <% for breadcrumb in breadcrumbs { %>
        <p class="breadcrumb">/</p>
        <a class="breadcrumb" href="<%= breadcrumb.href %>"><%= breadcrumb.name %></a>
      <% } %>
    </div>
    <% if !info.is_empty() { %>
      <div class="dir-info-container">
        <div class="dir-info">
          <%- info %>
        </div>
      </div>
    <% } %>
    <% if files.is_empty() && directories.is_empty() { %>
      <p class="dir-empty"><strong>Nothing here :c</strong></p>
    <% } %>
    <div class="listing-container">
      <% for directory in directories { %>
        <a class="listing-thumbnail" href="/<%= directory.public_path %>">
          <img src="<%= directory.thumbnail_path %>" alt="<%= directory.name %>" loading="lazy" />
          <p class="caption"><%= directory.name %></p>
        </a>
      <% } %>
      <% for file in files { %>
        <a class="listing-thumbnail" href="/<%= file.public_path %>">
          <img src="/<%= file.thumbnail_path %>" alt="<%= file.name %>" loading="lazy" />
          <p class="caption caption-hidden"><%= file.name %></p>
        </a>
      <% } %>
    </div> <!-- listing-container -->
  </body>
</html>
