<!DOCTYPE html>

<html>
  <head>
    <% include!("./header.stpl"); %>
  </head>
  <body>
    <div class="view-container">
      <img
        class="view view-preview"
        src="/<%= file.thumbnail_path %>"
        alt="<%= file.name %> preview"
      />
      <img
        class="view"
        src="/<%= file.public_content_path %>"
        alt="<%= file.name %>"
      />
    </div>
  </body>
</html>
